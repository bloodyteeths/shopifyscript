# Ads Autopilot AI Backend Configuration
# Copy this file to .env and update with your actual values

# ================================
# APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=3005
BACKEND_URL=http://localhost:3005
BACKEND_PUBLIC_URL=http://localhost:3005/api
WP_BACKEND_URL=http://localhost:3005

# ================================
# SECURITY
# ================================
# Generate a strong secret (32+ characters) - used for HMAC authentication
HMAC_SECRET=change_me_to_a_secure_32_char_minimum_secret

# Admin key for secret rotation and administrative endpoints
# Generate with: openssl rand -hex 32
ADMIN_KEY=change_me_to_a_secure_admin_key

# CORS configuration
ALLOWED_ORIGINS=https://ads-autopilot-ui.vercel.app,https://admin.shopify.com,http://localhost:3000

# Security headers (lightweight, serverless-friendly)
# Set to 'true' to enable, 'false' to disable (default: true in production, false in development)
ENABLE_SECURITY_HEADERS=true

# ================================
# MULTI-TENANT CONFIGURATION
# ================================
# Default tenant ID for development
TENANT_ID=adsautopilot

# Tenant registry mapping tenant IDs to Google Sheet IDs
TENANT_REGISTRY_JSON='{"adsautopilot":"PUT_MASTER_SHEET_ID_HERE"}'

# ================================
# GOOGLE SERVICES
# ================================
# Google Sheets API credentials
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PROJECT_ID=your-project-id
SHEET_ID=PUT_MASTER_SHEET_ID_HERE

# ================================
# AI SERVICES
# ================================
# AI Provider Configuration
AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.4
AI_MAX_CALLS_PER_RUN=20
AI_READY=TRUE
AI_SKIP_BUDGET_CHECK=true

# Gemini AI API
GEMINI_API_KEY=AIzaSyYOUR_GEMINI_API_KEY_HERE

# ================================
# SUPABASE DATABASE
# ================================
SUPABASE_ENABLED=true
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ================================
# REDIS CACHE
# ================================
REDIS_URL=redis://localhost:6379
KV_URL=redis://localhost:6379

# Cache TTL settings (in seconds)
INSIGHTS_CACHE_TTL_SEC=60
CONFIG_CACHE_TTL_SEC=15
RUNLOGS_CACHE_TTL_SEC=10

# ================================
# RATE LIMITING
# ================================
# Maximum number of requests per minute per IP+tenant combination
RATE_LIMIT_MAX=60

# ================================
# SHOPIFY INTEGRATION
# ================================
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# ================================
# AUDIENCE CONFIGURATION
# ================================
AUDIENCE_MIN_SIZE=1000

# ================================
# FEATURE FLAGS
# ================================
STARTER_ENABLED=true
