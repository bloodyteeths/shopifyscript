# Ads Autopilot AI Shopify UI Environment Configuration
# Copy this file to .env and update with your actual values

# ================================
# APPLICATION SETTINGS
# ================================
# Note: NODE_ENV is omitted to avoid jsxDEV build issues in Vercel
PORT=3000

# ================================
# BACKEND INTEGRATION
# ================================
# Backend API URL (must include /api suffix)
BACKEND_PUBLIC_URL=http://localhost:3005/api

# ================================
# MULTI-TENANT CONFIGURATION
# ================================
# Default tenant ID
TENANT_ID=adsautopilot

# Tenant registry mapping tenant IDs to Google Sheet IDs
TENANT_REGISTRY_JSON='{"adsautopilot":"PUT_MASTER_SHEET_ID_HERE"}'

# Default development tenant (fallback)
DEFAULT_DEV_TENANT=adsautopilot

# ================================
# SECURITY
# ================================
# HMAC secret (must match backend)
HMAC_SECRET=change_me_to_a_secure_32_char_minimum_secret

# ================================
# SHOPIFY APP CONFIGURATION
# ================================
# Shopify App Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# Shopify App URL (your Vercel deployment or localhost)
SHOPIFY_APP_URL=http://localhost:3000

# Shopify OAuth Scopes
SCOPES=read_products,write_products

# ================================
# GOOGLE SHEETS (Direct Access)
# ================================
# Google Sheets Configuration (for direct access if needed)
GOOGLE_SHEETS_CLIENT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PROJECT_ID=your-project-id
SHEET_ID=PUT_MASTER_SHEET_ID_HERE

# ================================
# REDIS CACHE
# ================================
# Redis connection URL
REDIS_URL=redis://localhost:6379

# ================================
# AI CONFIGURATION
# ================================
# Skip budget checks for AI operations (set to false in production)
AI_SKIP_BUDGET_CHECK=true
